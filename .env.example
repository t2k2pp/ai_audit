# =============================================================================
# ai_audit 設定ファイル
# =============================================================================
# このファイルを .env にコピーして、各項目を自分の環境に合わせて編集してください。
#   cp .env.example .env
#
# ★ 必須項目（未設定のままだとツールが起動しません）
# ★ 任意項目（未設定でも動作します）
# =============================================================================


# =============================================================================
# ★ 必須: LLM API 接続先
# =============================================================================
# llama.cpp を使う場合: http://<サーバーIP>:8080/v1
# Ollama を使う場合: http://<サーバーIP>:11434/v1
#   例: http://192.168.1.40:11434/v1
#
# OpenAI API を使う場合: https://api.openai.com/v1
#
LLM_API_BASE_URL=


# =============================================================================
# ★ 必須: API キー
# =============================================================================
# Ollama を使う場合: 任意の文字列でOK（例: ollama）
# OpenAI API を使う場合: sk-... 形式のキー
#
LLM_API_KEY=


# =============================================================================
# ★ 必須: 使用するモデル名
# =============================================================================
# 利用可能なモデルは以下で確認できます:
#   python main.py config model
#
# 例: qwen3.8-flash-next / gpt-oss:120b / qwen2.5-coder:32b
#
LLM_MODEL_NAME=


# =============================================================================
# 任意: 最大出力トークン数
# =============================================================================
# LLM が1回のリクエストで生成できるトークン数の上限（出力のみ。入力は別）
#
# 未設定（コメントアウト）→ ティアに応じた既定値（compact 1024 / standard 4096 / large 8192）
# 整数値                  → 指定値を上限とする（大きいほど詳細な指摘、推論時間は増加）
#
# CLIからも変更できます:
#   python main.py config output-tokens 4096   # 上限を指定
#   python main.py config output-tokens auto   # モデルのデフォルト最大値に戻す
#
# LLM_MAX_OUTPUT_TOKENS=4096


# =============================================================================
# 任意: コンテキストとティア（v0.4〜）
# =============================================================================
# 最大コンテキスト長。未設定ならサーバ（llama.cpp / vLLM / Ollama）から自動取得。
# 取得できないサーバでは 4096 として扱うため、設定を推奨。
# LLM_CONTEXT_LENGTH=262144
#
# 1 リクエストで使うトークン数の上限（未設定 = 最大コンテキストの 50%、上限 128K。16K 以下なら全量）
# LLM_CONTEXT_BUDGET=131072
#
# ティア（未設定 = 自動判定）: compact（〜8K）/ standard（〜64K）/ large（64K 超）
# AI_AUDIT_TIER=large

# =============================================================================
# 任意: 推論パラメータ（v0.4〜）
# =============================================================================
# 思考モード: off / low / medium / high（off 以外で reasoning_effort を送信。解釈はサーバ依存）
# LLM_REASONING=off
#
# リクエストに追加する JSON（サーバ固有パラメータ）
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
#
# 同時リクエスト数（推論サーバの並列数に合わせる）
# LLM_PARALLEL=1
#
# サーバ種別: auto / llamacpp / vllm / ollama / openai
# LLM_SERVER_TYPE=auto
#
# 1 リクエストのタイムアウト（秒）
# LLM_TIMEOUT=3600

# =============================================================================
# 任意: 設計思想検索の埋め込みモデル（v0.4〜）
# =============================================================================
# 推論サーバの /v1/embeddings で使うモデル名。未設定なら語彙検索のみ。
# LLM_EMBEDDING_MODEL=

# =============================================================================
# 任意: データ保存先（サーバ検出結果・トークン補正係数）
# =============================================================================
# AI_AUDIT_DATA_DIR=~/.ai_audit
